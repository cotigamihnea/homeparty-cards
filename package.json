{
  "name": "homeparty-cards",
  "productName": "Homeparty Cards",
  "version": "0.1.0",
  "description": "A local-network, Jackbox-style party game of Cards Against Humanity. Unofficial fan project.",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/dev.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "start": "npm run build && electron .",
    "serve": "npm run build && node dist/server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json && tsc -p tests/client/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "package": "npm run build && electron-builder --win --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "make-icon": "tsx scripts/render-icon.ts",
    "fetch-cards": "tsx scripts/fetch-cards.ts",
    "test:coverage": "vitest run --coverage"
  },
  "build": {
    "appId": "com.homeparty.cards",
    "productName": "Homeparty Cards",
    "artifactName": "Homeparty-Cards-${version}-${os}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "data/cah-all-compact.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "dir"
    },
    "extraFiles": [
      "LICENSE",
      "LICENSE-CARDS.md"
    ]
  },
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "20.14.5",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "esbuild": false
  },
  "author": "cotigamihnea",
  "license": "(MIT AND CC-BY-NC-SA-4.0)"
}
